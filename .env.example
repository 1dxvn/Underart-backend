# Bases de datos
DB_URL=jdbc:postgresql://localhost:5432/underart
DB_USER=postgres
DB_PASSWORD=postgres
MONGO_URI=mongodb://localhost:27017/underart

# Sesión: access token corto (ms) y refresh token (duración ISO-8601)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRATION_MS=900000
AUTH_REFRESH_TOKEN_TTL=P30D

# IA
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Navegadores permitidos (separados por comas, admite comodines)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Multimedia en Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=underart-media
R2_PUBLIC_URL=https://media.tu-dominio.com

# Pagos: simulated | stripe
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=tu-clave-secreta-de-stripe
STRIPE_CURRENCY=usd
